# ============================================================
# 秘密情報は絶対にコミットしない。ここには変数名と説明だけ。
# Claude Code のクラウド環境変数にも OPENAI_API_KEY を設定しないこと
# （環境を使う人が誰でも読めるため。docs/SECURITY.md 参照）
# ============================================================

# --- OpenAI ---
# サーバー専用。lib/openai/client.ts からのみ読む。NEXT_PUBLIC_ を付けない
OPENAI_API_KEY=
# Realtime のモデル名。コードに直書きせず必ずここから読む（mini との比較のため）
OPENAI_REALTIME_MODEL=
# 生徒が話し終わったと判断するまでの積極さ: low / medium / high / auto
# 既定は high（速い）。反応が速すぎて言い終わる前に割り込まれるなら medium か low へ
REALTIME_VAD_EAGERNESS=
# Safety Identifier のハッシュ用ソルト。生の学籍番号を OpenAI へ送らないため
SAFETY_ID_SALT=

# --- 採点器 ---
# 学期の途中で勝手に変わらないようピン留めする（docs/RUBRIC.md 参照）
SCORER_MODEL=
SCORER_PROMPT_VERSION=v1

# --- データベース ---
# 開発中はセッション内の PostgreSQL でよい
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role キー。サーバー専用。scores への書き込みに使う
SUPABASE_SERVICE_ROLE_KEY=

# --- アプリ ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# /api/realtime/session のレート制限（1生徒あたり1時間）
REALTIME_SESSIONS_PER_HOUR=6
